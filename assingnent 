                    cout << "\nNo crops registered in the system yet.\n";
                    break;
                }
                cout << "\n" << string(92, '-') << endl;
                cout << left << setw(15) << "Crop Name" 
                     << setw(10) << "Area(Acre)" 
                     << setw(12) << "Season" 
                     << setw(15) << "Yield/Acre" 
                     << setw(15) << "Total Yield" 
                     << setw(20) << "Fertilizer" 
