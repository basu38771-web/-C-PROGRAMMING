            case 7:
                loadCropsFromFile("crop_data.txt");
                break;
            case 8:
                cout << "\nTotal active crops in memory: " << Crop::getTotalCropCount() << endl;
                break;
            case 9:
                cout << "\nExiting Smart Farm Management System. Cleaning up memory...\n";
                break;
            default:
                cout << "\n[Error] Invalid choice. Please select between 1 and 9.\n";
        }
    } while (choice != 9);

    for (auto crop : farm) {
        delete crop;
    }
    farm.clear();

    return 0;
}


