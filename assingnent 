                break;
            }
            case 4: {
                if (farm.size() < 2) {
                    cout << "\nYou need at least 2 crops registered to compare yields.\n";
                    break;
                }
                cout << "\nRegistered Crops List:\n";
                for (size_t i = 0; i < farm.size(); ++i) {
                    cout << i << ". " << farm[i]->getName() << " (Total Yield: " << farm[i]->calculateTotalYield() << ")\n";
                }
                size_t idx1, idx2;
                cout << "Enter index of first crop: ";
                cin >> idx1;
                cout << "Enter index of second crop: ";
                cin >> idx2;

                if (idx1 < farm.size() && idx2 < farm.size()) {
                    if (*farm[idx1] > *farm[idx2]) {
                        cout << "\nResult: " << farm[idx1]->getName() << " has a higher total yield than " << farm[idx2]->getName() << ".\n";
                    } else if (*farm[idx2] > *farm[idx1]) {
                        cout << "\nResult: " << farm[idx2]->getName() << " has a higher total yield than " << farm[idx1]->getName() << ".\n";
                    } else {
                        cout << "\nResult: Both crops have equal total yields.\n";
                    }
                } else {
                    cout << "[Error] Invalid indices selected.\n";
                }
                break;
            }
            case 5: {
                if (farm.empty()) {
                    cout << "\nNo crops available for advisory.\n";
                    break;
                }
                cout << "\n--- Expert Farming Advisories ---\n";
                for (const auto& crop : farm) {
                    Advisory* adv = dynamic_cast<Advisory*>(crop);
                    if (adv) {
                        adv->giveAdvice();
                    }
                }
                break;
            }
            case 6:
                saveAllCropsToFile(farm, "crop_data.txt");
