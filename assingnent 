        cout << "4. Compare Two Crops by Yield\n";
        cout << "5. Get Farming Advisories\n";
        cout << "6. Save Crop Data to File\n";
        cout << "7. Load Crop Data from File\n";
        cout << "8. Show Active Crop Count\n";
        cout << "9. Exit\n";
        cout << "Enter your choice (1-9): ";
        
